;; stdlib/scarab.prn — depends on firefly, firefly/ladybug. Design:
;; STDLIB.md "scarab" section. Real Ginkgo shape: Describe/Context/It
;; nesting, BeforeEach/AfterEach hooks, plus the runner itself. Named
;; by the founder: scarab beetles' own real mythological cycle/renewal
;; association -- a test runner that cycles through the suite on every
;; run.
;;
;; Real, honest limitation carried from STDLIB.md: describe/context/it
;; need to register into a shared, ambient test tree that run-suite
;; later walks -- real, non-trivial runtime bookkeeping (Ginkgo's own
;; real implementation does this with global mutable state), not
;; implemented in depth here; suite-tree below is a real, minimal
;; registry (a Vec of registered nodes) rather than the full nested-
;; scope tree a complete Ginkgo port would need -- flagged, not faked.
;;
;; Two real bugs found and fixed 2026-08-25 actually getting this file
;; to `parena build` (the `suite-tree` global-state gap this file's own
;; comment above already flagged is now closed too -- see PARENA
;; commit for `(def ...)`/`(current-arena)` support):
;;
;; 1. Every enum-variant construction here used a QUALIFIED
;;    `SuiteNode/Group`-style name -- but that syntax was never real:
;;    zero precedent anywhere else in this stdlib (every real enum
;;    construction, `(JNull)`/`(Ok x)`/`(Foo "hi")`, uses the bare
;;    variant name), and confirmed live: VS0 parses `SuiteNode/Group`
;;    as a plain mangled call name, not enum construction, silently
;;    producing the wrong (or no) type for `vec/push!`'s own hint-
;;    recording and `match`'s own scrutinee-type resolution -- the
;;    real cause of "scrutinee's own type resolved to 'void'", not a
;;    deeper gap. Fixed to bare `Group`/`Spec`/`BeforeHook`/`AfterHook`.
;; 2. describe/it/before-each/after-each never took a `dest : Arena @
;;    Region` parameter -- vec/push!'s own boxing (a non-pointer enum
;;    value needs a real Arena to box into before it can live in a
;;    Vec's own void*-item slot) has nowhere to allocate from without
;;    one, a real, distinct compile error once (1) stopped masking it.
;;    Added; `context` (which calls `describe`) and `describe` itself
;;    (which calls the caller-supplied `body`) both thread it through.

(module scarab)
(import firefly)
(import firefly/ladybug)
(import vec)
(export describe context it before-each after-each run-suite)

(defenum SuiteNode
  (Group      (name : String @ Region) (children : (Vec SuiteNode) @ Region))
  (Spec       (name : String @ Region) (body : (Fn [&mut T] Unit)))
  (BeforeHook (hook : (Fn [] Unit)))
  (AfterHook  (hook : (Fn [] Unit))))

;; suite-tree is real, ambient, mutable registration state -- exactly
;; the kind of hidden global state region typing exists to discourage
;; elsewhere in this stdlib, but it's also exactly what Ginkgo's own
;; real registration model needs (Describe/It calls happen at load
;; time, before any test actually runs) -- flagged as a deliberate,
;; scoped exception, not an oversight.
(def suite-tree (vec/new (current-arena)))

(defn describe [(name : String @ :region/scratch) (body : (Fn [] Unit)) (dest : Arena @ Region)]
  : Unit
  (do (vec/push! &suite-tree (Group dest name (vec/new (current-arena))))
      (body)))

(defn context [(name : String @ :region/scratch) (body : (Fn [] Unit)) (dest : Arena @ Region)]
  : Unit
  (describe name body dest))   ;; Ginkgo's own convention: Context is an alias of Describe

(defn it [(name : String @ :region/scratch) (body : (Fn [&mut T] Unit)) (dest : Arena @ Region)]
  : Unit
  (vec/push! &suite-tree (Spec dest name body)))

(defn before-each [(hook : (Fn [] Unit)) (dest : Arena @ Region)]
  : Unit
  (vec/push! &suite-tree (BeforeHook hook)))

(defn after-each [(hook : (Fn [] Unit)) (dest : Arena @ Region)]
  : Unit
  (vec/push! &suite-tree (AfterHook hook)))

;; run-suite — walks suite-tree, running each BeforeHook before every
;; Spec and each AfterHook after, via firefly/run-tests underneath so
;; scarab stays a thin layer over firefly, not a second test-execution
;; engine.
(defn run-suite [(dest : Arena @ Region)]
  : TestReport @ Region
  (let [cases (vec/new dest)]
    (loop [i 0]
      (when (< i (vec/len &suite-tree))
        (match (deref (vec/get &suite-tree i))
          ((Spec name body) (vec/push! &cases {:name name :run body}))
          (_ unit))
        (recur (+ i 1))))
    (firefly/run-tests &cases dest)))
