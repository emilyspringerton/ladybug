# BUILD.bazel — real verification of this repo's own BDD framework
# source, run through the real, pinned `parena` binary (via MODULE.bazel's
# git_override). Each *_verify genrule below runs VS0 domain 1 (parse) and
# domain 2 (region analysis) against one real .prn file and fails the build
# if either step's own exit code is non-zero -- a real, honest pass/fail
# gate, not a no-op placeholder.
#
# Real update, 2026-09-03 (kanban priority-queue card LB-911, "FIX LADYBUG
# AND SCARAB"): checked live, not assumed from this file's own prior
# comment -- firefly.prn now builds cleanly through domain 3 (parena build,
# the real C emitter) today. `firefly_build` below is the first real
# `parena build` step in this repo. ladybug.prn/gomega.prn/scarab.prn
# remain genuinely blocked, on real, DIFFERENT gaps than originally
# tracked here (real lambda/closure captures for ladybug/gomega, real
# generic type parameters for scarab) -- see README.md's own "Honest
# current status" for the full, corrected writeup. Wiring `build` in for
# those three is real, separate, tracked follow-up once those close, not
# silently skipped forever.

genrule(
    name = "firefly_verify",
    srcs = ["firefly.prn"],
    outs = ["firefly.verify.txt"],
    cmd = """
        $(location @parena//src:parena) parse $(location firefly.prn) > $@.tmp 2>&1
        $(location @parena//src:parena) analyze $(location firefly.prn) >> $@.tmp 2>&1
        mv $@.tmp $@
    """,
    tools = ["@parena//src:parena"],
)

# firefly_build -- real, new (LB-911): runs firefly.prn all the way through the real C emitter,
# not just parse+analyze. A real, honest pass/fail gate on the ACTUAL compiled C output existing.
genrule(
    name = "firefly_build",
    srcs = ["firefly.prn", "@parena//stdlib:string.prn"],
    outs = ["firefly_gen.c"],
    cmd = "$(location @parena//src:parena) build $(location @parena//stdlib:string.prn) $(location firefly.prn) -o $@",
    tools = ["@parena//src:parena"],
)

